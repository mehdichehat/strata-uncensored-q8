+// ---- the arena's pages, made resident BEFORE CUDA pins them -------------------------------
+//
+// `cudaHostRegister` does not only PIN a range, it POPULATES it: the driver faults every page in inside one
+// ioctl, on one of its own threads.  On a PC whose page cache holds the model files, that single thread waits
+// on the kernel's direct compaction for every 2 MiB page it faults in (THP=madvise, defrag=madvise), and the
+// 119.53 GiB expert arena took 455 s that way - past the server's 900 s start budget, so the engine never
+// reported READY and the setup called it dead.  The kernel counters during that registration: compact_stall
+// +95,755, compact_fail +82,816.
+//
+// The engine can make the SAME pages resident itself, on several threads, before the registration: the driver
+// then finds the pages there and only pins them.
+//   measured on this PC (RTX 3090 x4, 251 GiB RAM, Linux, THP=madvise, defrag=madvise), 119.53 GiB arena,
+//   the page cache holding 205 GiB of the model files and 15 GiB free - the state a warm restart finds:
+//       the driver populates it alone              455 s  (compact_stall +95,755)
+//       the engine populates it, 16 threads        23.7 s  (compact_stall +70,020)   [standalone arena]
+//       the registration of that resident arena      6.2 s
+//   the same population inside the engine took 123.5 s there (the engine holds more of the machine while it
+//   runs), and the engine then reported READY at about 235 s; the driver's way never reported READY inside
+//   the server's 900 s budget.
+//   with the page cache cold (144 GiB free) the same arena registered in 4.2 s the driver's way and 2.4 s
+//   this way (32 GiB arena: 4.15 s against 0.62 s + 1.75 s).
+// The pages are the same either way; only WHO faults them in changes.
+//
+// The population WRITES every page once (a write, not a read: a read fault maps the shared zero page, which
+// is not residency - the page must be written to become the arena's own).  A store per 4 KiB is enough: the
+// first store in a 2 MiB region faults the huge page in and the rest of it is there.
+namespace {
+
+// The arena is filled in slices of this size, and the rate is checked between them.
+constexpr uint64_t kPopulateSliceBytes = 256ull << 20;
+// Below this rate the kernel is spending its time compacting for every huge page it is asked for.  Measured:
+// 5.0 GiB/s with the page cache warm and the compaction storm running, 51 GiB/s with the page cache cold, so
+// this threshold sits an order of magnitude below the slow case - it fires only when the arena would take
+// more than two minutes to fill.
+constexpr double kPopulateMinGiBPerSecond = 1.0;
+constexpr int kPopulateMaxThreads = 16;
+
+void write_pages(uint8_t* p, uint64_t bytes) {
+    volatile uint8_t* v = p;   // volatile: the stores must not be optimized away
+    for (uint64_t off = 0; off < bytes; off += 4096) v[off] = 0;
+}
+
+// madvise() wants a page-aligned address and a whole number of pages: the arena is split over the threads in
+// equal parts, and that split does not land on a page boundary, so the range is aligned here.  False when there
+// is nothing left to advise.
+bool drop_huge_pages(uint8_t* p, uint64_t bytes) {
+#ifdef MADV_NOHUGEPAGE
+    if (bytes == 0) return false;
+    const uintptr_t start = (uintptr_t) p;
+    const uintptr_t aligned = (start + 4095) & ~(uintptr_t) 4095;
+    if (aligned - start >= bytes) return false;   // less than a page left
+    return madvise((void*) aligned, (size_t) (bytes - (aligned - start)), MADV_NOHUGEPAGE) == 0;
+#else
+    (void) p;
+    (void) bytes;
+    return false;
+#endif
+}
+
+}  // namespace
+
+ArenaPopulation populate_host_arena(void* p, uint64_t bytes) {
+    ArenaPopulation r;
+    if (p == nullptr || bytes == 0) return r;
+#ifdef _WIN32
+    // Windows: the arena is a VirtualAlloc reservation and the driver fills it in one go; the Windows path is
+    // not what the Linux start budget was measured on, so it stays as it is.
+    (void) bytes;
+    return r;
+#else
+    // STRATA_NO_ARENA_PREPOP=1 is the same-run A/B switch the other STRATA_* arena switches are: the driver
+    // populates the arena itself, as it did before.
+    if (const char* e = std::getenv("STRATA_NO_ARENA_PREPOP")) {
+        if (e[0] != '\0' && std::string(e) != "0") return r;
+    }
+    unsigned hw = std::thread::hardware_concurrency();
+    int threads = (int) (hw < (unsigned) kPopulateMaxThreads ? (hw ? hw : 1u) : (unsigned) kPopulateMaxThreads);
+    const uint64_t chunk = (bytes + (uint64_t) threads - 1) / (uint64_t) threads;
+
+    std::atomic<uint64_t> done{0};
+    std::atomic<bool> huge_pages_dropped{false};
+    const auto t0 = std::chrono::steady_clock::now();
+    std::vector<std::thread> pool;
+    pool.reserve((size_t) threads);
+    for (int t = 0; t < threads; ++t) {
+        const uint64_t start = (uint64_t) t * chunk;
+        if (start >= bytes) break;
+        const uint64_t end = std::min(bytes, start + chunk);
+        pool.emplace_back([p, start, end, &done, &huge_pages_dropped, t0]() {
+            uint8_t* base = (uint8_t*) p + start;
+            uint64_t off = 0;
+            bool dropped = false;   // this thread's own range: the advice is per range, not global
+            while (off < end - start) {
+                const uint64_t n = std::min(kPopulateSliceBytes, end - start - off);
+                write_pages(base + off, n);
+                off += n;
+                done.fetch_add(n, std::memory_order_relaxed);
+                // The rate tells whether the kernel is compacting for every huge page: the huge-page request
+                // is then taken off the rest of THIS thread's range, and 4 KB pages need no compaction at all.
+                const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+                const double gib = (double) done.load(std::memory_order_relaxed) / (double) (1ull << 30);
+                if (!dropped && elapsed > 0.5 && gib / elapsed < kPopulateMinGiBPerSecond) {
+                    if (drop_huge_pages(base + off, end - start - off)) {
+                        dropped = true;
+                        huge_pages_dropped.store(true, std::memory_order_relaxed);
+                    }
+                }
+            }
+        });
+    }
+    for (std::thread& th : pool) th.join();
+    r.seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    r.threads = threads;
+    r.bytes = bytes;
+    r.huge_pages_dropped = huge_pages_dropped.load(std::memory_order_relaxed);
+    return r;
+#endif
+}
+
 PinnedArena::PinnedArena(uint64_t bytes, uint64_t slice) : PinnedArena(bytes, uniform_bounds(bytes, slice)) {
     if (slice_bytes) slice_bytes = slice;   // sliced registration: record the uniform size
 }
