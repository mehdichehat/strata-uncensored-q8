--- /dev/null
+++ b/tests/core/arena_populate_test.cpp
@@ -0,0 +1,110 @@
+// tests/core/arena_populate_test.cpp - the expert arena's pages are resident BEFORE CUDA pins them.
+//
+// The arena is 119.53 GiB on this model, and cudaHostRegister POPULATES the range it is given: one driver
+// thread, one ioctl, and on a host whose page cache holds the model files that thread waits on the kernel's
+// direct compaction for every 2 MiB page (455 s, past the server's 900 s start budget).  The engine therefore
+// makes the pages resident itself, on several threads, before the registration.
+//
+// What this test pins down:
+//   * every page of the range is RESIDENT afterwards (a range that was only mapped, or only read, is not
+//     resident: a read fault maps the shared zero page),
+//   * the pages still hold ZEROS, so the arena is empty for the load that fills it,
+//   * the call reports what it did (the bytes, the threads, the time), because the startup print says it.
+//
+// The residency check reads /proc/self/smaps, NOT mincore: mincore's answer is a BITPACKED byte per eight
+// pages, and the kernel this was measured on (6.17.0-41-generic) writes ONE BYTE PER PAGE instead - a vector
+// sized the documented way is then written past its end.  smaps says the same thing (the Rss of the mapping)
+// and cannot overflow anything.
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "strata/core/pinned.hpp"
+
+#if defined(__linux__)
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace {
+
+int failures = 0;
+
+void check(bool ok, const std::string& what) {
+    std::printf("%s %s\n", ok ? "ok  " : "FAIL", what.c_str());
+    if (!ok) ++failures;
+}
+
+// The resident bytes of [p, p + bytes) according to /proc/self/smaps: the Rss of every mapping that overlaps
+// the range, added up.  A mapping is reported as a whole, so the caller keeps the range between two PROT_NONE
+// guards - then the only mapping that overlaps it IS it, and the number is exact.
+uint64_t resident_bytes_smaps(const void* p, uint64_t bytes) {
+    std::FILE* f = std::fopen("/proc/self/smaps", "r");
+    if (f == nullptr) return 0;
+    const uint64_t lo = (uint64_t) (uintptr_t) p, hi = lo + bytes;
+    uint64_t rss = 0;
+    bool overlaps = false;
+    char line[512];
+    while (std::fgets(line, sizeof line, f) != nullptr) {
+        // A mapping header looks like "7f9c2c000000-7f9c2c400000 rw-p 00000000 00:00 0 ".
+        unsigned long long a = 0, b = 0;
+        if (std::sscanf(line, "%llx-%llx", &a, &b) == 2) {
+            overlaps = (b > lo && a < hi);
+            continue;
+        }
+        if (!overlaps) continue;
+        unsigned long long kb = 0;
+        if (std::sscanf(line, "Rss: %llu kB", &kb) == 1) rss += kb * 1024ull;
+    }
+    std::fclose(f);
+    return rss;
+}
+
+}  // namespace
+
+int main() {
+    const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    const size_t bytes = (size_t) 512 << 20;   // 512 MiB: enough pages to be a real test, small enough for CI
+    // One reservation, guards at both ends: the mapping under test cannot be merged with a neighbour, so its
+    // Rss in smaps is the range's and nothing else.
+    const size_t total = bytes + 2 * page;
+    char* region = (char*) mmap(nullptr, total, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (region == MAP_FAILED) {
+        std::printf("FAIL cannot map %zu bytes\n", total);
+        return 1;
+    }
+    if (mprotect(region, page, PROT_NONE) != 0 || mprotect(region + page + bytes, page, PROT_NONE) != 0) {
+        std::printf("FAIL cannot guard the mapping\n");
+        return 1;
+    }
+    void* p = region + page;
+
+    const uint64_t before = resident_bytes_smaps(p, bytes);
+    check(before == 0, "a freshly mapped range has no resident pages");
+
+    const strata::core::ArenaPopulation pop = strata::core::populate_host_arena(p, bytes);
+    check(pop.bytes == bytes, "the population reports the bytes it was given");
+    check(pop.threads >= 1, "the population reports the threads it used");
+    check(pop.seconds >= 0.0, "the population reports its time");
+
+    const uint64_t after = resident_bytes_smaps(p, bytes);
+    check(after >= bytes, "every page of the range is resident afterwards");
+
+    const unsigned char* q = (const unsigned char*) p;
+    bool zeros = true;
+    for (size_t i = 0; i < bytes; i += page) {
+        if (q[i] != 0) { zeros = false; break; }
+    }
+    check(zeros, "the pages still hold zeros: the arena is empty for the load");
+
+    munmap(region, total);
+    std::printf("%s\n", failures == 0 ? "arena_populate_test: ok" : "arena_populate_test: FAILED");
+    return failures == 0 ? 0 : 1;
+}
+#else
+int main() {
+    std::printf("arena_populate_test: skipped (Linux only)\n");
+    return 0;
+}
+#endif
