+++ b/tools/test_setup_local_changes.py
@@ -0,0 +1,57 @@
+"""A Strata folder with local changes (a local/ folder with patches) keeps them: a new copy of Strata set up like
+that install says which patches it has to apply before it compiles the upstream source.
+
+    python -m unittest tools.test_setup_local_changes
+"""
+from __future__ import annotations
+
+import io
+import sys
+import tempfile
+import unittest
+from contextlib import redirect_stdout
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "tools"))
+import setup  # noqa: E402
+
+
+class LocalChanges(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.folder = Path(tmp.name)
+
+    def test_the_patches_of_a_folder_are_found(self):
+        self.assertEqual(setup.local_change_patches(self.folder), [])
+        local = self.folder / "local"
+        local.mkdir()
+        (local / "uncensored-q8-mtp.patch").write_text("--- a\n+++ b\n", encoding="utf-8")
+        (local / "arena-prepop.patch").write_text("--- c\n+++ d\n", encoding="utf-8")
+        (local / "README.md").write_text("not a patch\n", encoding="utf-8")
+        self.assertEqual([p.name for p in setup.local_change_patches(self.folder)],
+                         ["arena-prepop.patch", "uncensored-q8-mtp.patch"])
+
+    def test_a_copy_set_up_like_it_is_told_about_the_patches(self):
+        local = self.folder / "local"
+        local.mkdir()
+        patch = local / "uncensored-q8-mtp.patch"
+        patch.write_text("--- a\n+++ b\n", encoding="utf-8")
+        out = io.StringIO()
+        with redirect_stdout(out):
+            setup.warn_local_changes(self.folder)
+        said = out.getvalue()
+        self.assertIn("uncensored-q8-mtp.patch", said)
+        self.assertIn("git apply", said)
+
+    def test_an_untouched_folder_says_nothing(self):
+        out = io.StringIO()
+        with redirect_stdout(out):
+            setup.warn_local_changes(self.folder)
+        self.assertEqual(out.getvalue(), "")
+
+
+if __name__ == "__main__":
+    unittest.main()
