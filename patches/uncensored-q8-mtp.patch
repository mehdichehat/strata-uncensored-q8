+// Files with an integrated MTP draft block (qwen4exp.nextn_predict_layers, e.g. the Uncensored Q8_0-MTP file
+// with block_count 49): the first blk.* index that belongs to the draft, or `hold` when the shard carries no
+// such metadata. The target walk skips those blocks the way it skips another stage's layers; the draft is
+// served from mtp/rt, and the pack does not index them.
+int draft_cut(const strata::GgufFile& gguf, int hold) {
+    if (hold >= 0) return hold;
+    const auto* blocks = gguf.get("qwen4exp.block_count");
+    const auto* nextn = gguf.get("qwen4exp.nextn_predict_layers");
+    if (!blocks || !blocks->is_num() || !nextn || !nextn->is_num() || nextn->u == 0) return hold;
+    if (nextn->u > blocks->u) return hold;
+    return (int) (blocks->u - nextn->u);
+}
+// True for a blk.<l>. tensor of the integrated draft (see draft_cut): skipped by the target walk.
+bool is_draft(const std::string& name, int cut) {
+    if (cut < 0 || name.rfind("blk.", 0) != 0) return false;
+    return std::atoi(name.c_str() + 4) >= cut;
+}
